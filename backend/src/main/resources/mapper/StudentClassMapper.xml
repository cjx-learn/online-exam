<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.exam.mapper.StudentClassMapper">
    
    <!-- 结果映射 -->
    <resultMap id="StudentClassResultMap" type="com.exam.entity.StudentClass">
        <id property="id" column="id"/>
        <result property="studentId" column="student_id"/>
        <result property="classId" column="class_id"/>
        <result property="joinTime" column="join_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    
    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="StudentClassResultMap">
        SELECT * FROM student_class WHERE id = #{id}
    </select>
    
    <!-- 查询学生的所有班级关联 -->
    <select id="selectByStudentId" resultMap="StudentClassResultMap">
        SELECT * FROM student_class 
        WHERE student_id = #{studentId}
        ORDER BY join_time DESC
    </select>
    
    <!-- 查询班级的所有学生关联 -->
    <select id="selectByClassId" resultMap="StudentClassResultMap">
        SELECT * FROM student_class 
        WHERE class_id = #{classId}
        ORDER BY join_time ASC
    </select>
    
    <!-- 查询学生是否已加入班级 -->
    <select id="selectByStudentAndClass" resultMap="StudentClassResultMap">
        SELECT * FROM student_class 
        WHERE student_id = #{studentId} AND class_id = #{classId}
        LIMIT 1
    </select>
    
    <!-- 插入学生-班级关联 -->
    <insert id="insert" parameterType="com.exam.entity.StudentClass" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO student_class (student_id, class_id, join_time, status)
        VALUES (#{studentId}, #{classId}, #{joinTime}, #{status})
    </insert>
    
    <!-- 更新状态 -->
    <update id="updateStatus">
        UPDATE student_class SET status = #{status} WHERE id = #{id}
    </update>
    
    <!-- 删除关联 -->
    <delete id="deleteById">
        DELETE FROM student_class WHERE id = #{id}
    </delete>
    
    <!-- 根据学生ID和班级ID删除关联 -->
    <delete id="deleteByStudentAndClass">
        DELETE FROM student_class WHERE student_id = #{studentId} AND class_id = #{classId}
    </delete>
    
</mapper>

