<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.exam.mapper.AdminMapper">

    <resultMap id="BaseResultMap" type="com.exam.entity.Admin">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="real_name" property="realName"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="super_admin" property="superAdmin"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM admin WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT * FROM admin WHERE username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin (username, password, real_name, email, phone, super_admin, status)
        VALUES (#{username}, #{password}, #{realName}, #{email}, #{phone}, #{superAdmin}, #{status})
    </insert>

    <update id="update">
        UPDATE admin
        SET username = #{username},
            password = #{password},
            real_name = #{realName},
            email = #{email},
            phone = #{phone},
            super_admin = #{superAdmin},
            status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM admin WHERE id = #{id}
    </delete>

</mapper>

